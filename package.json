{
  "name": "workshift",
  "version": "0.1.0",
  "private": true,
  "description": "WorkShift — a global, evidence-driven AI Career Intelligence platform. No fabricated data, no login required.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/seed.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "quality:scan": "tsx scripts/production-data-integrity-check.ts"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@prisma/client": "^5.18.0",
    "zod": "^3.23.0",
    "recharts": "^2.12.0",
    "maplibre-gl": "^4.5.0",
    "lucide-react": "^0.400.0",
    "motion": "^11.0.0",
    "clsx": "^2.1.0",
    "tailwind-merge": "^2.4.0",
    "class-variance-authority": "^0.7.0",
    "rss-parser": "^3.13.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "prisma": "^5.18.0",
    "vitest": "^2.0.0",
    "@playwright/test": "^1.46.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "tsx": "^4.16.0",
    "wrangler": "^3.68.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
