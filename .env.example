# ─────────────────────────────────────────────────────────────────
# WorkShift — Environment Variables
# Copy this file to .env, fill in real values, and NEVER commit .env.
# Every variable below is actually read by the codebase (see lib/env.ts).
# Leaving an optional variable blank disables that integration
# gracefully — it does not produce fake data.
# ─────────────────────────────────────────────────────────────────

# ---- Database (required) ----------------------------------------
# PostgreSQL connection string. Supabase Postgres is the default
# target; any standard Postgres works.
DATABASE_URL="postgresql://user:password@host:5432/workshift?schema=public"
# Optional separate URL for Prisma migrations if you use a pooled
# connection (e.g. PgBouncer/Supabase pooler) for DATABASE_URL.
DIRECT_DATABASE_URL=""

# ---- AI providers (all optional; at least one recommended) ------
# The AI provider abstraction (lib/ai) only enables a provider when
# its key is present. With none set, all AI-assisted features
# (recommendations, claim extraction, summarization) are disabled
# and the UI shows "AI analysis unavailable" rather than fabricating output.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OPENROUTER_API_KEY=""
GROQ_API_KEY=""
# Which provider to prefer when multiple are configured.
AI_PROVIDER_PRIORITY="anthropic,openai,google,openrouter,groq"

# ---- Cloudflare (required for ingestion workers & scheduling) ---
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""

# ---- Site ----------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="WorkShift"

# ---- Admin auth (protected internal dashboard only; public site
#      has no login) ------------------------------------------------
ADMIN_SESSION_SECRET=""
ADMIN_ALLOWED_EMAILS=""

# ---- Rate limiting / caching (optional; falls back to in-memory
#      limiter if unset — fine for dev, not for multi-instance prod) -
REDIS_URL=""

# ---- Ingestion / scraping safety ----------------------------------
# Comma-separated list of hostnames the ingestion fetcher is allowed
# to contact. Anything else is rejected before the request is made.
INGESTION_ALLOWED_HOSTS=""
# Per-request timeout in ms for source fetches.
INGESTION_FETCH_TIMEOUT_MS="10000"

# ---- Observability --------------------------------------------------
LOG_LEVEL="info"
